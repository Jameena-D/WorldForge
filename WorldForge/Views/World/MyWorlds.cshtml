@model IEnumerable<WorldForge.ViewModel.WorldViewModel>
@using WorldForge.Models
@using Shared.Enum

<h2>My Worlds</h2>

@if (!Model.Any())
{
    <p>You haven’t created any worlds yet.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Name</th>
                <th>Description</th>
                <th>World Type</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var world in Model)
            {
                <tr>
                    <td>@world.Name</td>
                    <td>@world.Description</td>
                    <td>@world.WorldType</td>
                </tr>
            }
        </tbody>
    </table>
}

@if (TempData["SuccessMessage"] != null)
{
    <div id="successPopup" class="alert alert-success position-fixed top-0 start-50 translate-middle-x mt-4 shadow"
         style="z-index: 9999;">
        @TempData["SuccessMessage"]
    </div>

    <script>
        setTimeout(function () {
            const popup = document.getElementById("successPopup");
            if (popup) {
                popup.remove();
            }
        }, 3000);
    </script>
}

<div class="text-center">
    <h1 class="display-4">Welcome to WorldForge</h1>
</div>