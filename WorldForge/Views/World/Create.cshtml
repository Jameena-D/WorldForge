@model WorldForge.ViewModel.CreateWorldViewModel
@using WorldForge.Models

@{
    ViewData["Title"] = "Create World";
}

<div class="d-flex justify-content-center mt-4">
    <div class="card w-100" style="max-width:580px">

        <div class="card-header p-4">
            <h2 class="text-white mb-1 fw-bold">🌍 Create a New World</h2>
        </div>

        <div class="card-body p-4">
            <form asp-action="Create" method="post">

                <div class="field-box">
                    <label asp-for="Name">World Name</label>
                    <input asp-for="Name" class="form-control" placeholder="e.g. Ebrone…" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="field-box">
                    <label asp-for="Description">Description</label>
                    <textarea asp-for="Description" class="form-control" rows="3" placeholder="Describe your world…"></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <div class="field-box">
                    <label asp-for="WorldType">World Type</label>
                    <select asp-for="WorldType" class="form-select" asp-items="Html.GetEnumSelectList<WorldForge.Models.WorldTypeEnum>()">
                        <option value="">Choose a genre…</option>
                    </select>
                    <span asp-validation-for="WorldType" class="text-danger small"></span>
                </div>

                <div class="field-box d-flex justify-content-between align-items-center">
                    <label asp-for="IsPublic" class="mb-0">Make this world public?</label>
                    <input asp-for="IsPublic" type="checkbox" class="form-check-input" style="width:2.5rem;height:1.4rem" />
                </div>

                <button type="submit" class="btn-create mt-2">✨ Create World</button>

            </form>
        </div>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}