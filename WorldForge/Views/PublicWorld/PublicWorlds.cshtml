@model List<WorldForge.ViewModel.PublicWorldViewModel>

<h2>Public Worlds</h2>

<div class="world-list">
@foreach (var world in Model)
{
    <div class="world-card">
        <h3>@world.Name</h3>
        <p>@world.Description</p>
        <p>Type: @world.WorldType</p>
        <a asp-controller="PublicWorld" asp-action="PublicWorldDetail" asp-route-id="@world.Id" class="btn btn-primary">View</a>
    </div>
}
</div>
