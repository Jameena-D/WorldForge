@model WorldForge.ViewModel.PublicWorldDetailViewModel
@using Shared.Enum

@{
    ViewData["Title"] = "Public detail world";
}

<div class="d-flex justify-content-center mt-4 gap-4 flex-wrap">
    <!-- World Card -->
    <div class="card flex-fill" style="flex: 1 1 400px; max-width: 580px;">
        <div class="card-header p-4">
            <h2 class="mb-1">🌍 @Model.Name</h2>
        </div>

        <div class="card-body p-4">

            <!-- World fields read-only -->
            <div class="field-box mb-3">
                <label>World Name</label>
                <p class="form-control-plaintext">@Model.Name</p>
            </div>

            <div class="field-box mb-3">
                <label>Description</label>
                <p class="form-control-plaintext">@Model.Description</p>
            </div>

            <div class="field-box mb-3">
                <label>World Type</label>
                <p class="form-control-plaintext">@Model.WorldType</p>
            </div>

            <!-- Sections read-only -->
            @if (Model.Sections != null && Model.Sections.Count > 0)
            {
                @foreach (var sec in Model.Sections)
                {
                    <div class="world-section mb-4">
                        <h3>@sec.Title</h3>

                        @if (sec.Blocks != null && sec.Blocks.Count > 0)
                        {
                            @foreach (var block in sec.Blocks)
                            {
                                <div class="block mb-3">
                                    <div class="field-box mb-1">
                                        <label>Name</label>
                                        <p class="form-control-plaintext">@block.Name</p>
                                    </div>
                                    <div class="field-box">
                                        <label>Content</label>
                                        <p class="form-control-plaintext">@block.Content</p>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                }
            }

            <!-- Button to go back-->
            <div class="world-actions">
                <a asp-controller="World" asp-action="MyWorlds" class="btn btn-primary mt-2">Back to My Worlds</a>
            </div>

        </div>
    </div>

    <!-- Comments Card -->
    <div class="card flex-fill" style="flex: 1 1 400px; max-width: 580px;">
        <div class="card-header p-3">
            <h5 class="mb-0">💬 Comments</h5>
        </div>
        <div class="card-body p-4" style="max-height: 700px; overflow-y: auto;">

            @if (Context.Session.GetString("IsLoggedIn") == "true")
            {
                <form asp-controller="PublicWorld" asp-action="PostComment" method="post" class="mb-4">
                    <input type="hidden" name="worldId" value="@Model.Id" />
                    <div class="mb-2">
                        <textarea name="content" class="form-control" rows="3" placeholder="Write a comment..." required></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary">Send the comment</button>
                </form>
            }
            else
            {
                <p class="text-muted mb-3"><a asp-controller="Account" asp-action="Login">Log in</a> to leave a comment.</p>
            }

            @if (Model.Comments == null || Model.Comments.Count == 0)
            {
                <p class="text-muted">No comments yet. Be the first!</p>
            }
            else
            {
                @foreach (var comment in Model.Comments)
                {
                    <div class="border rounded p-3 mb-3">
                        <div class="d-flex align-items-center mb-1">
                            <strong class="me-2">@comment.OwnerName</strong>
                            <small class="text-muted">@comment.CreatedAt.ToString("g")</small>
                        </div>
                        <p class="mb-0">@comment.Content</p>
                    </div>
                }
            }
        </div>
    </div>
</div>