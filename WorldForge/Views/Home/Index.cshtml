@{
    ViewData["Title"] = "Home Page";
}

<div class="welcome-section text-center">
    <h1 class="display-4 fw-bold">Welcome to WorldForge! ✨</h1>
    <h3 class="display-6 mt-3">
        Bring your own worlds to life! 🌍
    </h3>
</div>

<div class="d-flex justify-content-center mt-5">
    <div class="card welcome-card w-100">
        <div class="card-header text-center">
            <h3 class="mb-0">Create your world, your way</h3>
        </div>

        <div class="card-body text-center">
            <h4 class="card-title mb-3">
                Build unique worlds and turn them into complete stories.
            </h4>

            <p class="lead">
                Add locations, characters, lore and much more in an organized way.
                Whether you want to create a fantasy world, a game concept, or just need
                a place to be creative, WorldForge helps you shape your ideas.
            </p>

            <p>
                Create an account and start your journey today. Keep your world private
                or share it with others.
            </p>

            <div class="d-flex justify-content-center gap-3 mt-4">
                <a asp-controller="Account" asp-action="Register" class="btn welcome-btn btn-lg">
                    Start building your world 🌍
                </a>

                <a asp-controller="Account" asp-action="Login" class="btn welcome-btn btn-lg">
                    Continue building your world 🌍
                </a>
            </div>
        </div>
    </div>
</div>