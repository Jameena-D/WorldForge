@{
    var isLoggedIn = Context.Session.GetString("IsLoggedIn") == "true";
    var email = Context.Session.GetString("Email");
    var role = Context.Session.GetString("Role");
    var isAdmin = isLoggedIn && role == "Admin";
}

<ul class="navbar-nav ms-auto">
    @if (isLoggedIn)
    {
        <!-- MyWorld -->
        <li class="nav-item">
            <a class="nav-link" asp-area="" asp-controller="World" asp-action="MyWorlds">My worlds</a>
        </li>
        <!-- Create World -->
        <li class="nav-item">
            <form asp-controller="World" asp-action="Create" method="post" class="d-inline">
                <button type="submit" class="nav-link btn btn-link text-light">Create World</button>
            </form>
        </li>
        <!-- Public world page-->
        <li class="nav-item">
            <a class="nav-link" asp-controller="PublicWorld" asp-action="PublicWorlds">Public Worlds</a>
        </li>
        <!-- Admin Panel -->
        @if (isAdmin)
        {
            <li class="nav-item">
                <a class="nav-link text-warning" asp-controller="AdminReports" asp-action="Reports">Notifications</a>
            </li>
        }
        <!-- Email -->
        <li class="nav-item">
            <span class="nav-link text-light">@email</span>
        </li>
        <!-- Logout -->
        <li class="nav-item">
            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                <button type="submit" class="nav-link btn btn-link text-light">Logout</button>
            </form>
        </li>
    }
    else
    {
        <!-- Login -->
        <li class="nav-item">
            <a class="nav-link text-light" asp-controller="Account" asp-action="Login">Login</a>
        </li>
        <!-- Register -->
        <li class="nav-item">
            <a class="nav-link text-light" asp-controller="Account" asp-action="Register">Register</a>
        </li>
    }
</ul>
